NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendguard?schema=public

JWT_ACCESS_SECRET=spendguard_access_secret_super_secure_key_32bytes
JWT_REFRESH_SECRET=spendguard_refresh_secret_super_secure_key_32bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRAUD_LARGE_AMOUNT_MIN_THRESHOLD=5000
FRAUD_NEW_MERCHANT_HIGH_VALUE_THRESHOLD=10000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
